{
  "name": "turismo-argentina",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint --max-warnings=0",
    "typecheck": "next typegen && tsc --noEmit",
    "validate": "node --experimental-strip-types scripts/validate-data.mjs && npm run santa-fe:oficinas && npm run db:check && npm run validate:pages && npm run editorial:check && npm run editorial:check-pr13 && npm run editorial:check-pr14 && npm run editorial:check-work",
    "test": "node --experimental-strip-types --test tests/*.test.mjs",
    "check": "npm run lint && npm run typecheck && npm run validate && npm test && npm run build && npm run editorial:audit-next && npm run audit:seo && npm run test:e2e",
    "audit:seo": "node --experimental-strip-types scripts/audit-seo.mjs",
    "test:e2e": "playwright test",
    "inventory:media": "node --experimental-strip-types scripts/media-inventory.mjs",
    "migration:catalog": "node --experimental-strip-types scripts/catalog-migration-map.mjs",
    "import:dry-run": "node scripts/editorial-import.mjs",
    "db:types": "node scripts/supabase/generate-types.mjs",
    "db:check": "node scripts/supabase/generate-types.mjs --check",
    "build:pages": "node --experimental-strip-types scripts/pages/build.mjs",
    "santa-fe:oficinas": "node --experimental-strip-types scripts/santa-fe/exportar-oficinas.mjs",
    "validate:pages": "node --experimental-strip-types scripts/pages/validate.mjs",
    "test:pages": "node scripts/pages/prepare-tests.mjs && playwright test --config scripts/pages/playwright.config.ts",
    "editorial:review": "node --experimental-strip-types scripts/editorial/review.mjs",
    "editorial:plan": "node --experimental-strip-types scripts/editorial/plan.mjs",
    "editorial:check": "node --experimental-strip-types scripts/editorial/check.mjs",
    "editorial:audit-next": "node --experimental-strip-types scripts/editorial/next-audit.mjs",
    "editorial:links": "node scripts/editorial/pdf-links.mjs",
    "editorial:report-pr13": "node --experimental-strip-types scripts/pr13/report.mjs",
    "editorial:check-pr13": "node --experimental-strip-types scripts/pr13/check.mjs",
    "editorial:check-pr14": "node --experimental-strip-types scripts/pr14/check.mjs",
    "editorial:report-pr14": "node --experimental-strip-types scripts/pr14/manifest.mjs && node --experimental-strip-types scripts/pr14/report.mjs",
    "prebuild": "node --experimental-strip-types scripts/editorial/work-audit.mjs --check-inputs && node --experimental-strip-types scripts/editorial/publication.mjs && node --experimental-strip-types scripts/supabase/prepare-web-content.mjs",
    "editorial:check-work": "node --experimental-strip-types scripts/editorial/work-audit.mjs --check-inputs && node --experimental-strip-types scripts/editorial/publication.mjs",
    "editorial:audit-work": "node --experimental-strip-types scripts/editorial/work-audit.mjs",
    "editorial:preview-work": "node --experimental-strip-types scripts/editorial/preview-work.mjs",
    "editorial:review-batch": "node --experimental-strip-types scripts/editorial/review-batch.mjs",
    "editorial:serve-review": "node --experimental-strip-types scripts/editorial/review-server.mjs"
  },
  "dependencies": {
    "@next/third-parties": "16.4.3",
    "@supabase/supabase-js": "2.118.0",
    "@vercel/analytics": "2.0.1",
    "@vercel/speed-insights": "2.0.0",
    "leaflet": "^1.9.4",
    "next": "16.4.3",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-leaflet": "^5.0.0",
    "server-only": "0.0.1"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.11",
    "@playwright/test": "1.64.1",
    "@tailwindcss/postcss": "^4",
    "@types/leaflet": "^1.9.21",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.1.1",
    "sharp": "^0.34.5",
    "tailwindcss": "^4",
    "typescript": "^5",
    "xlsx": "^0.18.5"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "type": "module"
}
